---
/**
 * The page shell: head tags, the scheme script that runs before the first paint, the header and
 * the footer. Every page renders inside it.
 */
import '@fontsource/barlow/400.css';
import '@fontsource/barlow/500.css';
import '@fontsource/barlow/600.css';
import '@fontsource/barlow-condensed/600.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import sansLatin from '@fontsource/barlow/files/barlow-latin-400-normal.woff2?url';
import displayLatin from '@fontsource/barlow-condensed/files/barlow-condensed-latin-600-normal.woff2?url';
import '../styles/site.css';
import Seo from '../components/seo.astro';
import SiteFooter from '../components/site-footer.astro';
import SiteHeader from '../components/site-header.astro';
import { link } from '../lib/url.ts';

/** Props of the shell. */
interface Props {
  /** The page's title, without the site name. Omitted on the home page. */
  title?: string;
  /** What the home page's title says after the site name. */
  tagline?: string;
  /** The page's description. */
  description: string;
  /** `article` for a doc. */
  type?: 'website' | 'article';
  /** The navigation section the page belongs to. */
  current?: 'features' | 'compare' | 'try' | 'docs';
  /** The page's path when it is served at another address than its URL, such as `404.html`. */
  servedAt?: string;
  /** The site path of the page that stands for this one, such as the latest release's doc. */
  canonicalPath?: string;
}

const { title, tagline, description, type, current, servedAt, canonicalPath } = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Applies the stored colour scheme before the first paint. Storage can be blocked.
      (() => {
        let scheme = 'system';
        try {
          scheme = localStorage.getItem('mattebox.color-scheme') || 'system';
        } catch {}
        const dark =
          scheme === 'dark' ||
          (scheme !== 'light' && matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.dataset.scheme = scheme;
        document.documentElement.dataset.theme = dark ? 'dark' : 'light';
      })();
    </script>
    <Seo
      description={description}
      {...title === undefined ? {} : { title }}
      {...tagline === undefined ? {} : { tagline }}
      {...type === undefined ? {} : { type }}
      {...servedAt === undefined ? {} : { servedAt }}
      {...canonicalPath === undefined ? {} : { canonicalPath }}
    />
    <link rel="preload" href={sansLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={displayLatin} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href={link('favicon.svg')} type="image/svg+xml" />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader {...current === undefined ? {} : { current }} />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
