---
/**
 * One answer of the feature matrix as an icon: a check for yes, a half disc for partly, a cross
 * for no, a dash for not stated. The word stays in the page for screen readers, and the icon is
 * a link when the answer has a source.
 */
import type { Support } from '../data/matrix.ts';

interface Props {
  support: Support;
  /** Where the answer is stated, if anywhere. */
  href?: string | undefined;
}

const { support, href } = Astro.props;
const words: Record<Support, string> = {
  yes: 'Yes',
  partial: 'Partly',
  no: 'No',
  unstated: 'Not stated',
};
const Tag = href === undefined ? 'span' : 'a';
---

<Tag class:list={['support', support]} href={href} title={words[support]}>
  <svg viewBox="0 0 20 20" width="22" height="22" aria-hidden="true">
    {
      support === 'yes' && (
        <>
          <circle cx="10" cy="10" r="9" />
          <path d="M5.8 10.4 8.6 13.1 14.3 7.2" fill="none" stroke-width="2" />
        </>
      )
    }
    {
      support === 'partial' && (
        <>
          <circle cx="10" cy="10" r="8.25" fill="none" stroke-width="1.5" />
          <path d="M10 1.75a8.25 8.25 0 0 1 0 16.5z" stroke="none" />
        </>
      )
    }
    {
      support === 'no' && (
        <>
          <circle cx="10" cy="10" r="8.25" fill="none" stroke-width="1.5" />
          <path d="M7 7l6 6M13 7l-6 6" fill="none" stroke-width="1.75" />
        </>
      )
    }
    {support === 'unstated' && <path d="M6 10h8" fill="none" stroke-width="1.75" />}
  </svg>
  <span class="visually-hidden">{words[support]}</span>
</Tag>

<style>
  /* A 24 by 24 target around the 22 pixel icon. */
  .support {
    display: inline-flex;
    padding: 1px;
    border-radius: 50%;
    line-height: 0;
  }

  .support svg {
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    fill: currentColor;
  }

  .yes {
    color: var(--color-ok-ink);
  }

  /* The check is cut out of the disc, in the page's own colour. */
  .yes path {
    stroke: var(--color-ground);
  }

  .partial {
    color: var(--color-ink);
  }

  .no {
    color: var(--color-ink-secondary);
  }

  /* The secondary ink, not a border colour: a dash that means something needs 3:1. */
  .unstated {
    color: var(--color-ink-secondary);
  }

  a.support:hover,
  a.support:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
</style>
