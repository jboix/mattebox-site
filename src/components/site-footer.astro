---
/**
 * The footer: the site's pages, what a reader can try, the repositories, and the licence.
 */
import { collectedBooks, latestOf } from '../lib/docs.ts';
import { hosted, repositories } from '../lib/site.ts';
import { link } from '../lib/url.ts';
import Mark from './mark.astro';

const books = collectedBooks();
---

<footer class="site-footer">
  <div class="container columns">
    <div class="about">
      <a class="brand" href={link()}><Mark size={26} /><span>Mattebox</span></a>
      <p>An open source HLS and DASH player for the web. MIT licensed.</p>
    </div>
    <nav aria-label="Docs">
      <h2>Docs</h2>
      <ul>
        {books.map((book) => <li><a href={link(latestOf(book).path)}>{book.name}</a></li>)}
      </ul>
    </nav>
    <nav aria-label="Try it">
      <h2>Try it</h2>
      <ul>
        <li><a href={hosted.demo}>Player demo</a></li>
        <li><a href={hosted.playground}>Engine playground</a></li>
        <li><a href={hosted.editor}>Player editor</a></li>
        <li><a href={hosted.receiver}>Cast receiver</a></li>
        <li><a href={link('try/')}>All of them</a></li>
      </ul>
    </nav>
    <nav aria-label="Source">
      <h2>Source</h2>
      <ul>
        <li><a href={repositories.engine}>Engine</a></li>
        <li><a href={repositories.player}>Player</a></li>
        <li><a href={repositories.receiver}>Cast receiver</a></li>
        <li><a href={repositories.editor}>Player editor</a></li>
        <li><a href={repositories.site}>This site</a></li>
      </ul>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    padding: 56px 0;
    /* A rule, not a gap: the footer joins a charcoal section over it and still reads apart. */
    border-top: 1px solid #3f3f46;
    background: var(--color-charcoal);
    color: #cfc8bd;
  }

  .columns {
    display: grid;
    grid-template-columns: 1.6fr repeat(3, 1fr);
    gap: 32px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--color-paper);
    text-decoration: none;
    font: 600 1.375rem / 1 var(--font-display);
  }

  .about p {
    margin-top: 14px;
    max-width: 30ch;
  }

  h2 {
    margin-bottom: 12px;
    font: 500 0.75rem / 1.2 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #9a948a;
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    margin-bottom: 6px;
  }

  nav a {
    color: #e6dfd2;
    text-decoration: none;
  }

  nav a:hover {
    color: #ffffff;
    text-decoration: underline;
  }

  @media (max-width: 860px) {
    .columns {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
