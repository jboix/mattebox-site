---
/**
 * The menu on a narrow screen: a button in the header that opens a panel from the right, with the
 * site's pages, the repository, then what the page puts in the slot (the docs' navigation). A
 * native dialog keeps focus inside, closes on Escape and dims the page behind it. On a wide
 * screen the header shows the pages and the button hides.
 */
import { repositories } from '../lib/site.ts';

/** A page of the site, as the header lists it. */
interface Page {
  /** The navigation section the page stands for. */
  readonly id: string;
  /** The link's text. */
  readonly label: string;
  /** The page's address. */
  readonly href: string;
}

/** Props of the menu. */
interface Props {
  /** The site's pages, in order. */
  pages: readonly Page[];
  /** The navigation section of the page shown. */
  current?: string | undefined;
}

const { pages, current } = Astro.props;
---

<button
  type="button"
  class="menu-toggle"
  aria-label="Menu"
  aria-haspopup="dialog"
  aria-controls="site-menu"
  data-site-menu-open
>
  <svg
    viewBox="0 0 24 24"
    width="18"
    height="18"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    aria-hidden="true"
  >
    <path d="M4 7h16 M4 12h16 M4 17h16"></path>
  </svg>
</button>
<dialog class="drawer" id="site-menu" aria-label="Menu">
  <div class="drawer-body">
    <div class="drawer-head">
      <span class="drawer-title">Menu</span>
      <button type="button" class="drawer-close" aria-label="Close the menu" data-site-menu-close>
        <svg
          viewBox="0 0 16 16"
          width="16"
          height="16"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M3.5 3.5l9 9M12.5 3.5l-9 9"></path>
        </svg>
      </button>
    </div>
    <nav aria-label="Site">
      <ul class="site-links">
        {
          pages.map((page) => (
            <li>
              <a href={page.href} aria-current={page.id === current ? 'page' : undefined}>
                {page.label}
              </a>
            </li>
          ))
        }
        <li><a href={repositories.engine}>GitHub</a></li>
      </ul>
    </nav>
    <slot />
  </div>
</dialog>

<style>
  .menu-toggle {
    display: none;
    place-items: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-control);
    background: var(--color-surface);
    color: var(--color-ink-secondary);
    cursor: pointer;
  }

  .menu-toggle:hover {
    color: var(--color-ink);
    border-color: var(--color-border-control);
  }

  .drawer {
    width: min(320px, 86vw);
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0 0 0 auto;
    padding: 0;
    overflow: auto;
    border: 0;
    border-left: 1px solid var(--color-border);
    background: var(--color-ground);
    color: var(--color-ink);
  }

  /* The padding is the body's, so a press on the dialog itself is a press outside the panel. */
  .drawer-body {
    min-height: 100%;
    padding: 0 20px 24px;
  }

  .drawer::backdrop {
    background: color-mix(in srgb, var(--color-charcoal) 45%, transparent);
  }

  /* Above the docs' menus, whose open lists are positioned, so they scroll under it. It spans the
     panel's whole width, over the body's padding, so nothing shows beside it. */
  .drawer-head {
    position: sticky;
    z-index: 30;
    top: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 64px;
    margin: 0 -20px;
    padding: 0 20px;
    background: var(--color-ground);
  }

  .drawer-title {
    font: 600 1.25rem / 1 var(--font-display);
  }

  .drawer-close {
    display: inline-grid;
    place-items: center;
    width: 36px;
    height: 36px;
    padding: 0;
    border: 0;
    border-radius: var(--radius-control);
    background: transparent;
    color: var(--color-ink-secondary);
    cursor: pointer;
  }

  .drawer-close:hover {
    background: var(--color-surface-muted);
    color: var(--color-ink);
  }

  .site-links {
    display: grid;
    gap: 2px;
    margin: 0 0 16px;
    padding: 0 0 16px;
    border-bottom: 1px solid var(--color-border);
    list-style: none;
  }

  .site-links a {
    display: block;
    padding: 8px 12px;
    border-left: 2px solid transparent;
    color: var(--color-ink);
    font-weight: 500;
    text-decoration: none;
  }

  .site-links a[aria-current="page"] {
    border-left-color: var(--color-vermilion);
  }

  @media (max-width: 860px) {
    .menu-toggle {
      display: inline-grid;
    }
  }
</style>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('#site-menu');
  document
    .querySelector('[data-site-menu-open]')
    ?.addEventListener('click', () => dialog?.showModal());
  document
    .querySelector('[data-site-menu-close]')
    ?.addEventListener('click', () => dialog?.close());
  // A press on the dimmed page, outside the panel, closes it.
  dialog?.addEventListener('click', (event) => {
    if (event.target === dialog) dialog.close();
  });
</script>
