---
/**
 * The comparison: what each player states it supports, beside the bytes it costs, then the
 * smaller comparisons the home page does not show, and the licence and price of each player.
 */
import SizeBars from '../components/size-bars.astro';
import SupportMark from '../components/support-mark.astro';
import { compared, comparedOn } from '../data/compare.ts';
import { featureGroups } from '../data/features.ts';
import {
  type Cell,
  extras,
  matrix,
  matrixCheckedOn,
  type RivalId,
  rivals,
  type Support,
} from '../data/matrix.ts';
import Base from '../layouts/base.astro';
import { chapterHref, collectedBooks, latestOf } from '../lib/docs.ts';
import { ours, readSizes } from '../lib/sizes.ts';
import { link } from '../lib/url.ts';

const sizes = readSizes();
const books = collectedBooks();
const yes = (value: boolean) => (value ? 'Yes' : 'No');

const features = featureGroups.flatMap((group) => group.features);
const rows = matrix.flatMap((group) => group.rows);

/** A column of the matrix: Mattebox, then each other player, with its size from the chart. */
interface Column {
  readonly id: 'mattebox' | RivalId;
  readonly name: string;
  readonly version: string;
  readonly kilobytes: number;
}

/** A player's size, read off the player chart by its row's label. */
const sizeOf = (label: string) => {
  const row = sizes.player.rows.find((each) => each.label === label);
  if (row === undefined) throw new Error(`The player chart has no row "${label}".`);
  return row.kilobytes;
};
const playerBook = books.find((book) => book.id === 'player');
const columns: readonly Column[] = [
  {
    id: 'mattebox',
    name: '@mattebox/player',
    version: playerBook === undefined ? '' : latestOf(playerBook).version,
    kilobytes: ours(sizes.player),
  },
  ...rivals.map((rival) => ({
    id: rival.id,
    name: rival.name,
    version: rival.version,
    kilobytes: sizeOf(rival.chartLabel),
  })),
];

/**
 * A row's answer for a column. Mattebox's answer is yes, linked to the docs section, when the
 * row names one of its features, and no, linked to the feature list, when it does not.
 */
const cellOf = (row: (typeof rows)[number], id: Column['id']): Cell => {
  if (id !== 'mattebox') return row.cells[id];
  if (row.feature === undefined) return { support: 'no', source: link('features/') };
  const feature = features.find((each) => each.name === row.feature);
  if (feature === undefined) throw new Error(`No feature named ${row.feature}.`);
  const yes: Cell = { support: 'yes', source: chapterHref(books, feature.doc) };
  return row.oursNote === undefined ? yes : { ...yes, note: row.oursNote };
};
/**
 * The notes, numbered in reading order: row by row, then column by column. A cell shows its
 * number, and the list under the table holds the words, so every icon sits at the same height.
 */
const notes = rows.flatMap((row) =>
  columns.flatMap((column) => {
    const note = cellOf(row, column.id).note;
    return note === undefined ? [] : [{ row, column, note }];
  }),
);
const noteNumber = (row: (typeof rows)[number], id: Column['id']) =>
  notes.findIndex((each) => each.row === row && each.column.id === id) + 1;
/** How many rows a column answers with `support`. */
const count = (id: Column['id'], support: Support) =>
  rows.filter((row) => cellOf(row, id).support === support).length;
const legend: readonly [Support, string][] = [
  ['yes', 'Stated'],
  ['partial', 'Stated in part'],
  ['no', 'Stated as missing'],
  ['unstated', 'Not stated either way'],
];
const hlsRival = sizes.hls.rows[1];
---

<Base
  title="Compare"
  description="Mattebox against Shaka Player, video.js 10, Bitmovin and THEOplayer: what each states it supports, the measured bundle sizes, licence and price."
  current="compare"
>
  <div class="container section">
    <p class="eyebrow">Compare</p>
    <h1 class="section-title">More per kilobyte</h1>
    <p class="lede">
      What each player states it supports, beside what it costs your viewers in bytes. Every cell
      links to its source.
    </p>

    <section class="block">
      <h2>Features and size</h2>
      <p>
        {rows.length} features, and what each player states about them. @mattebox/player has{' '}
        {count('mattebox', 'yes')} of them in {ours(sizes.player).toFixed(1)} KB.
      </p>
      <ul class="legend">
        {
          legend.map(([support, meaning]) => (
            <li>
              <SupportMark support={support} />
              <span>{meaning}</span>
            </li>
          ))
        }
      </ul>
      <div class="scroll">
        <table class="matrix">
          <thead>
            <tr>
              <th scope="col" class="feature">Feature</th>
              {
                columns.map((column) => (
                  <th scope="col" class:list={['player', { ours: column.id === 'mattebox' }]}>
                    <span class="name">{column.name}</span>
                    <span class="version mono">v{column.version}</span>
                  </th>
                ))
              }
            </tr>
          </thead>
          {
            matrix.map((group) => (
              <tbody>
                <tr class="group">
                  <th scope="colgroup" colspan={columns.length + 1}>
                    {group.title}
                  </th>
                </tr>
                {group.rows.map((row) => (
                  <tr>
                    <th scope="row" class="feature">
                      {row.label}
                    </th>
                    {columns.map((column) => {
                      const cell = cellOf(row, column.id);
                      return (
                        <td class:list={['answer', { ours: column.id === 'mattebox' }]}>
                          <span class="mark">
                            <SupportMark support={cell.support} href={cell.source} />
                            {cell.note !== undefined && (
                              <a
                                class="ref"
                                href={`#note-${noteNumber(row, column.id)}`}
                                aria-describedby={`note-${noteNumber(row, column.id)}`}
                                data-note={cell.note}
                              >
                                <span aria-hidden="true">{noteNumber(row, column.id)}</span>
                                <span class="visually-hidden">Note {noteNumber(row, column.id)}</span>
                              </a>
                            )}
                          </span>
                        </td>
                      );
                    })}
                  </tr>
                ))}
              </tbody>
            ))
          }
          <tfoot>
            <tr>
              <th scope="row" class="feature">
                Stated in full
              </th>
              {
                columns.map((column) => (
                  <td class:list={['answer', { ours: column.id === 'mattebox' }]}>
                    <span class="total">{count(column.id, 'yes')}</span>
                    <span class="cell-note">
                      of {rows.length}
                      {count(column.id, 'partial') > 0 && `, ${count(column.id, 'partial')} partly`}
                    </span>
                  </td>
                ))
              }
            </tr>
            <tr>
              <th scope="row" class="feature">
                The whole player, min+gzip
              </th>
              {
                columns.map((column) => (
                  <td class:list={['answer', 'size', { ours: column.id === 'mattebox' }]}>
                    {column.kilobytes.toFixed(1)} KB
                  </td>
                ))
              }
            </tr>
          </tfoot>
        </table>
      </div>
      <details class="notes-box" id="notes">
        <summary>{notes.length} notes on the cells above</summary>
        <ol class="notes">
          {
            notes.map((each, index) => (
              <li id={`note-${index + 1}`}>
                <strong>{each.column.name}</strong>, {each.row.label}: {each.note}.
              </li>
            ))
          }
        </ol>
      </details>
      <div class="tip" role="tooltip" hidden></div>
      <p class="note">
        Checked on {matrixCheckedOn}. "Not stated" means the project's docs and source say nothing
        either way. A video.js 10 cell counts what its media elements give through SPF, hls.js and
        dash.js, the build the size measures. The sizes are the{' '}
        <a href="https://github.com/jboix/mattebox-player/blob/main/scripts/size-chart.mjs"
          >player chart</a
        >, the one on the <a href={link('')}>home page</a>.
      </p>
    </section>

    <section class="block">
      <h2>Where the others go further</h2>
      <p>
        Features each player states that @mattebox/player does not have. Each links to where its project
        states it.
      </p>
      <div class="further">
        {
          rivals.map((rival) => (
            <section class="card">
              <h3>{rival.name}</h3>
              <ul>
                {extras[rival.id].map((extra) => (
                  <li>
                    <a href={extra.source}>{extra.name}</a>
                  </li>
                ))}
              </ul>
            </section>
          ))
        }
      </div>
    </section>

    <section class="block">
      <h2>Against video.js 10's own engine</h2>
      <p>
        Video.js 10 has its own HLS engine, SPF. It plays HLS with fMP4 segments and{' '}
        <a
          href="https://github.com/videojs/video.js/blob/main/packages/spf/src/playback/engines/hls-video.ts"
          >DRM</a
        >, on demand and live, without MPEG-TS, low-latency HLS or DASH. The engine's{' '}
        <code>hls-drm</code> preset has the same reach. Mattebox is {ours(sizes.hls).toFixed(1)} KB{
          hlsRival !== undefined && `, video.js 10 ${hlsRival.kilobytes.toFixed(1)} KB`
        }. Both rows are the HTML player with its default skin.
      </p>
      <SizeBars chart={sizes.hls} first="Mattebox player" />
      <p class="note">
        <a href="https://videojs.org">videojs.org</a> states a smaller figure. Its{' '}
        <a href="https://github.com/videojs/video.js/blob/main/site/scripts/snapshot-bundle-sizes.mjs"
          >snapshot script</a
        >{' '}
        measures the React preset with a plain <code>&lt;video&gt;</code>, so the figure plays no HLS
        and no DASH. The{' '}
        <a href="https://github.com/videojs/video.js/blob/main/.github/scripts/bundle-size.js"
          >measurement</a
        >{' '}
        leaves out React and compresses with brotli at quality 11. The charts here use gzip at level
        9.
      </p>
    </section>

    <section class="block">
      <h2>Or less, if you need less</h2>
      <p>
        The engine is a kernel and the stages you add. A preset is a ready-made list. An HLS-only
        page downloads the first rows, and nothing of DASH or DRM.
      </p>
      <SizeBars chart={sizes.presets} />
      <p class="note">
        See <a href={link('docs/engine/presets-and-stages/')}>presets and stages</a> for what each
        preset holds.
      </p>
    </section>

    <section class="block">
      <h2>The engine alone</h2>
      <p>
        The part that reads the stream, against the engines other players are built on. Mattebox
        with every stage is {ours(sizes.engine).toFixed(1)} KB.
      </p>
      <SizeBars chart={sizes.engine} first="Mattebox" />
      <p class="note">
        The sizes come from the scripts in the{' '}
        <a href="https://github.com/jboix/mattebox/blob/main/scripts/size-chart.mjs">engine</a> and{' '}
        <a href="https://github.com/jboix/mattebox-player/blob/main/scripts/size-chart.mjs">player</a>{' '}
        repositories. Each one installs the other players from npm at the version shown and bundles
        them the same way, so you can run it and get the same numbers.
      </p>
    </section>

    <section class="block">
      <h2>Licence and price</h2>
      <div class="scroll">
        <table class="licences">
          <thead>
            <tr>
              <th scope="col">Player</th>
              <th scope="col">Licence</th>
              <th scope="col">Price</th>
              <th scope="col">HLS</th>
              <th scope="col">DASH</th>
              <th scope="col">Player interface</th>
            </tr>
          </thead>
          <tbody>
            {
              compared.map((each, index) => (
                <tr class:list={{ ours: index === 0 }}>
                  <th scope="row">{each.name}</th>
                  <td>
                    <a href={each.source}>{each.licence}</a>
                  </td>
                  <td>{each.price}</td>
                  <td>{yes(each.hls)}</td>
                  <td>{yes(each.dash)}</td>
                  <td>{each.interface}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="note">
        Checked on {comparedOn}. Each licence links to where its project states it. Bitmovin and
        Dolby publish their own prices, so this table does not repeat them.
      </p>
    </section>
  </div>
</Base>

<script>
  /**
   * The notes of the feature matrix: hovering or focusing a note's number shows the note in one
   * tooltip, placed in the viewport so the table's scroll box cannot clip it, and following the
   * number opens the folded list at that note.
   */
  const tip = document.querySelector<HTMLElement>('.tip');
  const notesBox = document.querySelector<HTMLDetailsElement>('#notes');

  /** Shows a note's words over its number. */
  function show(ref: HTMLElement): void {
    if (tip === null) return;
    tip.textContent = ref.dataset.note ?? '';
    tip.hidden = false;
    const box = ref.getBoundingClientRect();
    const width = tip.offsetWidth;
    const left = Math.min(
      Math.max(8, box.left + box.width / 2 - width / 2),
      window.innerWidth - width - 8,
    );
    const above = box.top - tip.offsetHeight - 8;
    tip.style.left = `${left}px`;
    tip.style.top = `${above < 8 ? box.bottom + 8 : above}px`;
  }

  /** Hides the tooltip. */
  function hide(): void {
    if (tip !== null) tip.hidden = true;
  }

  /** Opens the list when the address points at one of its notes. */
  function openAtHash(): void {
    if (notesBox !== null && location.hash.startsWith('#note-')) notesBox.open = true;
  }

  for (const ref of document.querySelectorAll<HTMLElement>('.matrix .ref')) {
    ref.addEventListener('pointerenter', () => show(ref));
    ref.addEventListener('pointerleave', hide);
    ref.addEventListener('focus', () => show(ref));
    ref.addEventListener('blur', hide);
    ref.addEventListener('click', () => {
      hide();
      if (notesBox !== null) notesBox.open = true;
    });
  }
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') hide();
  });
  window.addEventListener('scroll', hide, { passive: true });
  window.addEventListener('hashchange', openAtHash);
  openAtHash();
</script>

<style>
  .block {
    margin-top: 64px;
  }

  .block h2 {
    font-size: 2rem;
    padding-bottom: 8px;
    border-bottom: 3px solid var(--color-ink);
  }

  .scroll {
    overflow-x: auto;
  }

  .note {
    margin-top: 16px;
    font-size: 0.9375rem;
    color: var(--color-ink-secondary);
  }

  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    margin: 24px 0 32px;
    padding: 0;
    list-style: none;
    font-size: 0.875rem;
    color: var(--color-ink-secondary);
  }

  .legend li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  table {
    width: 100%;
    border-collapse: collapse;
  }

  /* Every cell has the same padding, highlighted or not, so the columns line up. */
  th,
  td {
    padding: 12px;
    border-bottom: 1px solid var(--color-border);
    text-align: left;
    vertical-align: top;
  }

  thead th {
    font: 500 0.6875rem / 1.2 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink-secondary);
    vertical-align: bottom;
  }

  tbody th {
    font-weight: 600;
  }

  .licences {
    min-width: 720px;
  }

  .matrix {
    min-width: 880px;
    table-layout: fixed;
  }

  .matrix th,
  .matrix td {
    padding: 12px 8px;
    vertical-align: middle;
  }

  .matrix thead th {
    vertical-align: bottom;
    padding-bottom: 14px;
    border-bottom: 2px solid var(--color-ink);
  }

  .matrix tfoot th,
  .matrix tfoot td {
    padding-top: 16px;
    border-top: 2px solid var(--color-ink);
    border-bottom: 0;
  }

  /* The highlight is a quiet tint; vermilion only marks the top of Mattebox's column. */
  .ours {
    background: var(--color-surface-muted);
  }

  .matrix .feature {
    position: sticky;
    left: 0;
    z-index: 1;
    width: 26%;
    padding-left: 0;
    text-align: left;
    font-weight: 500;
    background: var(--color-ground);
  }

  .matrix .player,
  .matrix .answer {
    text-align: center;
  }

  .matrix .name {
    display: block;
    font: 600 0.9375rem / 1.25 var(--font-sans);
    letter-spacing: 0;
    text-transform: none;
    color: var(--color-ink);
  }

  .matrix .version {
    display: block;
    margin-top: 4px;
    letter-spacing: 0;
    text-transform: none;
  }

  .matrix .player.ours {
    box-shadow: inset 0 3px 0 var(--color-vermilion);
  }

  .matrix .group th {
    padding: 28px 0 8px;
    border-bottom: 1px solid var(--color-border);
    font: 500 0.6875rem / 1.2 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink-secondary);
    background: var(--color-ground);
  }

  /* The note's number hangs to the right, so the icon stays in the centre of its column. */
  .matrix .mark {
    position: relative;
    display: inline-flex;
    vertical-align: middle;
  }

  /* 24 by 24, the smallest target a pointer should have to hit. */
  .matrix .ref {
    position: absolute;
    top: 50%;
    left: calc(100% + 2px);
    display: flex;
    align-items: flex-start;
    justify-content: flex-start;
    width: 24px;
    height: 24px;
    margin-top: -12px;
    font: 600 0.6875rem / 1 var(--font-mono);
    color: var(--color-accent);
    text-decoration: none;
  }

  .matrix .ref:hover span,
  .matrix .ref:focus-visible span {
    text-decoration: underline;
  }

  .matrix .cell-note {
    display: block;
    margin-top: 4px;
    font-size: 0.75rem;
    line-height: 1.3;
    color: var(--color-ink-secondary);
  }

  .notes-box {
    margin-top: 16px;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .notes-box summary {
    padding: 12px 0;
    cursor: pointer;
    font-weight: 600;
    font-size: 0.9375rem;
  }

  .notes {
    margin: 0 0 16px;
    padding-left: 24px;
    columns: 2 320px;
    column-gap: 40px;
    font-size: 0.8125rem;
    line-height: 1.45;
    color: var(--color-ink-secondary);
  }

  .tip {
    position: fixed;
    z-index: 10;
    max-width: 260px;
    padding: 8px 10px;
    border-radius: var(--radius-control);
    font-size: 0.8125rem;
    line-height: 1.4;
    color: var(--color-ink-inverse);
    background: var(--color-ink);
    pointer-events: none;
  }

  .notes li {
    break-inside: avoid;
    margin-bottom: 4px;
  }

  .notes li:target {
    color: var(--color-ink);
    background: var(--color-surface-muted);
  }

  .notes strong {
    color: var(--color-ink);
    font-weight: 600;
  }

  .matrix .total {
    display: block;
    font: 600 1.75rem / 1 var(--font-display);
  }

  .matrix .size {
    font: 600 1rem / 1.2 var(--font-mono);
    white-space: nowrap;
  }

  .matrix tfoot .feature {
    font-weight: 600;
  }

  .further {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 16px;
    margin-top: 24px;
  }

  .card {
    padding: 20px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    background: var(--color-surface);
  }

  .card h3 {
    margin: 0 0 12px;
    font-size: 1.125rem;
  }

  .card ul {
    margin: 0;
    padding-left: 18px;
    font-size: 0.9375rem;
    line-height: 1.6;
  }
</style>
