---
/**
 * Everything a reader can open and use in a browser: the demos, the playground, the editor and
 * the cast receiver.
 */
import { tryables } from '../data/try.ts';
import Base from '../layouts/base.astro';
import { collectedBooks, latestOf } from '../lib/docs.ts';
import { link } from '../lib/url.ts';

const books = collectedBooks();
/** The home of a book's docs. */
const docsOf = (id: string) => {
  const book = books.find((each) => each.id === id);
  return book === undefined ? undefined : { name: book.name, href: link(latestOf(book).path) };
};
---

<Base
  title="Try it"
  description="Open Mattebox in your browser: the player demo, the engine playground, the player editor, the playlist and reels demos, and the cast receiver."
  current="try"
>
  <div class="container section">
    <p class="eyebrow">Try it</p>
    <h1 class="section-title">Open it in your browser</h1>
    <p class="lede">
      Nothing to install. Each page runs the current main branch of its repository, and takes your
      own stream URL.
    </p>

    <div class="grid">
      {
        tryables.map((each) => {
          const docs = each.book === undefined ? undefined : docsOf(each.book);
          return (
            <article class="card item">
              <h2>
                <a href={each.href}>{each.name}</a>
              </h2>
              <p>{each.what}</p>
              <p class="links">
                <a class="button button-secondary" href={each.href}>
                  Open
                </a>
                {docs !== undefined && <a href={docs.href}>{docs.name} docs</a>}
                <a href={each.source}>Source</a>
              </p>
            </article>
          );
        })
      }
    </div>
  </div>
</Base>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 18px;
    margin-top: 40px;
  }

  .item {
    display: flex;
    flex-direction: column;
    padding: 24px;
    border-top: 3px solid var(--color-vermilion);
  }

  .item h2 {
    font-size: 1.75rem;
  }

  .item h2 a {
    color: var(--color-ink);
    text-decoration: none;
  }

  .item > p:first-of-type {
    flex: 1;
    color: var(--color-ink-secondary);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
    margin: 12px 0 0;
  }
</style>
