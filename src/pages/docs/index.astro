---
/**
 * The docs home: every book, grouped, with the versions it has.
 */
import Base from '../../layouts/base.astro';
import { collectedBooks, latestOf, menuOrder } from '../../lib/docs.ts';
import { link } from '../../lib/url.ts';

const books = collectedBooks();
const groups = [...new Set(books.map((book) => book.group))];
---

<Base
  title="Docs"
  description="The docs of every Mattebox deliverable: the engine, the player, and each accessory, each with its own versions."
  current="docs"
>
  <div class="container section">
    <p class="eyebrow">Docs</p>
    <h1 class="section-title">One book per deliverable</h1>
    <p class="lede">
      Each package is released on its own, so each book has its own versions. A page always says
      which book and which version you are reading.
    </p>

    {
      groups.map((group) => (
        <section class="group">
          <h2>{group}</h2>
          <div class="books">
            {books
              .filter((book) => book.group === group)
              .map((book) => {
                const latest = latestOf(book);
                return (
                  <article class="card book">
                    <h3>
                      <a href={link(latest.path)}>{book.name}</a>
                    </h3>
                    <p class="package mono">{book.packageName}</p>
                    <p>{book.summary}</p>
                    <ul class="versions mono">
                      {menuOrder(book).map((version) => (
                        <li>
                          <a href={link(version.path)} class:list={{ latest: version.latest }}>
                            {version.next ? 'next' : version.version}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </article>
                );
              })}
          </div>
        </section>
      ))
    }
  </div>
</Base>

<style>
  .group {
    margin-top: 48px;
  }

  .group h2 {
    font-size: 1.75rem;
    padding-bottom: 8px;
    border-bottom: 3px solid var(--color-ink);
  }

  .books {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 16px;
    margin-top: 20px;
  }

  .book {
    padding: 20px;
    border-top: 3px solid var(--color-vermilion);
  }

  .book h3 {
    margin-bottom: 2px;
    font-size: 1.5rem;
  }

  .book h3 a {
    color: var(--color-ink);
    text-decoration: none;
  }

  .book h3 a:hover {
    text-decoration: underline;
  }

  .package {
    font-size: 0.8125rem;
    color: var(--color-ink-secondary);
  }

  .versions {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.8125rem;
  }

  .versions li a {
    display: block;
    padding: 2px 8px;
    border: 1px solid var(--color-border-control);
    border-radius: var(--radius-pill);
    color: var(--color-ink-secondary);
    text-decoration: none;
  }

  .versions li a.latest {
    border-color: var(--color-ink);
    color: var(--color-ink);
    font-weight: 500;
  }
</style>
